{
  "name": "agenthub",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "api:test": ".\\.venv\\Scripts\\python.exe -m pytest apps/api/tests -q",
    "api:dev": ".\\.venv\\Scripts\\uvicorn.exe app.main:app --reload --app-dir apps/api --host 127.0.0.1 --port 43080",
    "web:dev": "npm --workspace @agenthub/web run dev",
    "local:dev": "node scripts/run-local-dev.mjs",
    "web:test": "npm --workspace @agenthub/web run test -- --run",
    "web:build": "npm --workspace @agenthub/web run build",
    "desktop:test": "npm --workspace @agenthub/desktop run test -- --run",
    "desktop:build": "npm --workspace @agenthub/desktop run build",
    "desktop:package:win": "npm --workspace @agenthub/desktop run package:win",
    "desktop:start": "npm --workspace @agenthub/desktop run start",
    "mobile:test": "npm --workspace @agenthub/mobile run test -- --run",
    "mobile:sync": "npm --workspace @agenthub/mobile run sync",
    "mobile:build:debug": "npm --workspace @agenthub/mobile run build:debug",
    "mobile:build:release": "npm --workspace @agenthub/mobile run build:release",
    "worker:cli:test": "npm --workspace agenthub-worker run test -- --run",
    "worker:version:check": "node scripts/check-worker-package-version.mjs"
  },
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/desktop",
    "packages/protocol",
    "packages/worker-cli"
  ]
}
