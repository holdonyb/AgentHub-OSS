{
  "name": "@agenthub/desktop",
  "version": "0.1.0",
  "description": "AgentHub desktop client",
  "author": "AgentHub contributors",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package:win": "npm run build && node scripts/package-win.mjs",
    "start": "electron .",
    "test": "vitest"
  },
  "build": {
    "appId": "xin.ifix.agenthub.desktop",
    "productName": "AgentHub",
    "electronVersion": "36.2.1",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "artifactName": "AgentHub-${version}-${arch}.${ext}",
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "electron": "^36.2.1",
    "electron-builder": "24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
