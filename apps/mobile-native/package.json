{
  "name": "@agenthub/mobile-native",
  "version": "1.0.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "build:android:debug": "node scripts/build-android-debug.mjs",
    "build:android:release": "node scripts/build-android-release.mjs",
    "build:ios:simulator": "node scripts/build-ios-simulator.mjs",
    "test": "node scripts/run-node-tests.mjs && jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "@agenthub/client-core": "1.0.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "expo": "~57.0.4",
    "expo-audio": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-clipboard": "^57.0.1",
    "expo-constants": "~57.0.3",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-modules-core": "~57.0.3",
    "expo-notifications": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.6",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-video": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "57.0.3",
    "@react-native/jest-preset": "0.86.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testRegex": "src/.*\\.test\\.tsx?$",
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/../../node_modules/uuid/dist/cjs/index.js"
    }
  }
}
