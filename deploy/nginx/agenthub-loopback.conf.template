server {
    listen 127.0.0.1:8019;
    server_name __AGENTHUB_SERVER_NAME__;

    root __AGENTHUB_WEB_ROOT__;
    index index.html;

    location = /healthz {
        proxy_pass http://__AGENTHUB_API_UPSTREAM__/healthz;
    }

    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://__AGENTHUB_API_UPSTREAM__;
    }

    location / {
        try_files $uri /index.html;
    }
}
