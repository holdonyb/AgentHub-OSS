limit_req_zone $binary_remote_addr zone=agenthub_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=agenthub_mutation:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=agenthub_worker:10m rate=120r/m;

server {
    listen 80;
    server_name __AGENTHUB_SERVER_NAME__;

    location /.well-known/acme-challenge/ {
        root /var/www/agenthub-certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name __AGENTHUB_SERVER_NAME__;

    ssl_certificate __AGENTHUB_TLS_CERT__;
    ssl_certificate_key __AGENTHUB_TLS_KEY__;

    root __AGENTHUB_WEB_ROOT__;
    index index.html;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 16m;
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    location = /healthz {
        proxy_pass http://__AGENTHUB_API_UPSTREAM__/healthz;
    }

    location /api/auth/login {
        limit_req zone=agenthub_login burst=5 nodelay;
        proxy_pass http://__AGENTHUB_API_UPSTREAM__;
    }

    location = /api/voice/transcribe {
        client_max_body_size 20m;
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
        proxy_pass http://__AGENTHUB_API_UPSTREAM__;
    }

    location ^~ /api/internal/ {
        return 403;
    }

    location = /api/workers/register {
        return 403;
    }

    location ~ ^/api/workers/[^/]+/heartbeat$ {
        return 403;
    }

    location = /api/worker/enroll {
        limit_req zone=agenthub_mutation burst=10 nodelay;
        proxy_pass http://__AGENTHUB_API_UPSTREAM__;
    }

    location ^~ /api/worker/ {
        limit_req zone=agenthub_worker burst=40 nodelay;
        proxy_read_timeout 120s;
        proxy_pass http://__AGENTHUB_API_UPSTREAM__;
    }

    location /api/ {
        limit_req zone=agenthub_mutation burst=30 nodelay;
        proxy_pass http://__AGENTHUB_API_UPSTREAM__;
    }

    location ^~ /downloads/workers/ {
        alias __AGENTHUB_DOWNLOADS_ROOT__/workers/;
        default_type application/octet-stream;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location /downloads/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
