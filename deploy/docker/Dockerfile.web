FROM node:20-bookworm AS web-build

WORKDIR /app

COPY package.json package-lock.json /app/
COPY apps/web/package.json /app/apps/web/package.json
COPY apps/mobile/package.json /app/apps/mobile/package.json
COPY apps/desktop/package.json /app/apps/desktop/package.json
COPY packages/protocol/package.json /app/packages/protocol/package.json
COPY packages/worker-cli/package.json /app/packages/worker-cli/package.json

RUN npm ci

COPY . /app
RUN npm run web:build

FROM python:3.13-slim AS worker-bundles

WORKDIR /app

COPY . /app
RUN python scripts/build-worker-bundle.py --output-root /tmp/worker-bundles --version docker-compose

FROM nginx:1.27-alpine

COPY deploy/docker/nginx-selfhost.conf /etc/nginx/conf.d/default.conf
COPY --from=web-build /app/apps/web/dist /usr/share/nginx/html
COPY --from=worker-bundles /tmp/worker-bundles /usr/share/nginx/html/downloads/workers
